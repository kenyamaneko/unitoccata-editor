{
  "name": "unitoccata-editor",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "oxlint",
    "typecheck": "tsc -b",
    "test": "firebase emulators:exec --only auth,storage,firestore --project demo-unitoccata-editor \"vitest run\"",
    "test:coverage": "firebase emulators:exec --only auth,storage,firestore --project demo-unitoccata-editor \"vitest run --coverage\"",
    "test:logic": "vitest run --project logic",
    "test:gui": "vitest run --project gui",
    "test:integration": "firebase emulators:exec --only auth,storage,firestore --project demo-unitoccata-editor \"vitest run --project integration --project integration-gui\"",
    "preview": "vite preview",
    "format": "prettier --write src",
    "format:check": "prettier --check src"
  },
  "dependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "firebase": "^12.19.0",
    "midi-file": "^1.2.4",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "signalsmith-stretch": "^1.3.2",
    "tailwindcss": "^4.3.3",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "^5.0.2",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@vitejs/plugin-react": "^6.1.1",
    "@vitest/coverage-v8": "^5.0.3",
    "firebase-tools": "^15.32.1",
    "jsdom": "^30.1.1",
    "msw": "^2.15.0",
    "oxlint": "^1.81.0",
    "prettier": "^3.9.9",
    "typescript": "~6.0.2",
    "vite": "^8.3.0",
    "vitest": "^5.0.3"
  },
  "engines": {
    "node": ">=24"
  }
}
